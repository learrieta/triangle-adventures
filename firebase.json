{
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https://fareharbor.com https://cdn.jsdelivr.net https://www.googletagmanager.com https://www.instagram.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://unpkg.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; media-src 'self'; frame-src 'self' https://fareharbor.com https://www.google.com https://www.instagram.com; connect-src 'self' https://api.emailjs.com https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|png|jpg|jpeg|webp|svg|woff2|mp4|mov)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/tours",
        "destination": "/locations/raleigh",
        "type": 301
      },
      {
        "source": "/tours/scenic-tour",
        "destination": "/locations/raleigh/scenic-tour",
        "type": 301
      },
      {
        "source": "/tours/ScenicTour",
        "destination": "/locations/raleigh/scenic-tour",
        "type": 301
      },
      {
        "source": "/tours/foods-and-drinks-tour",
        "destination": "/locations/raleigh/foods-and-drinks-tour",
        "type": 301
      },
      {
        "source": "/tours/FoodAndDrinks",
        "destination": "/locations/raleigh/foods-and-drinks-tour",
        "type": 301
      },
      {
        "source": "/tours/ghost-and-mysteries",
        "destination": "/locations/raleigh/ghost-and-mysteries",
        "type": 301
      },
      {
        "source": "/tours/ghost-and-misteries",
        "destination": "/locations/raleigh/ghost-and-mysteries",
        "type": 301
      },
      {
        "source": "/4-hour-tour",
        "destination": "/locations/raleigh/ghost-and-mysteries",
        "type": 301
      },
      {
        "source": "/aboutus",
        "destination": "/about-us",
        "type": 301
      }
    ],
    "predeploy": [
      "npm run build"
    ]
  }
}
